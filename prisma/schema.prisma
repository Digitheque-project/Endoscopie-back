generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Salle {
  id         String       @id @default(uuid())
  nom        String
  numero     String
  capacite   Int          @default(1)
  equipement String?      @default("")
  estActive  Boolean      @default(true)
  serviceId  String
  rendezVous RendezVous[]

  @@index([serviceId])
}

model Prescription {
  id                  String               @id @default(uuid())
  // Lien vers la prescription dans le service externe (source de vérité)
  externalId          String?              @unique
  // ID de la prescription externe "parente" (regroupement multi-examens) — capturé au
  // moment où l'examen est encore présent dans le flux externe en direct, car ce dernier
  // ne renvoie qu'un sous-ensemble récent/actif des demandes : sans ce cache local, un
  // examen qui en sort (terminé, ou simplement plus dans la fenêtre retournée) perdait
  // son rattachement au groupe et réapparaissait comme une ligne séparée dans le Fil.
  prescriptionExternalId String?
  serviceId           String
  patientId           String
  medecinId           String               @default("")
  typeExamen          String               @default("Endoscopie")
  motif               String?
  examensComplementaires String?
  // Raison écrite par le médecin Endoscopie en cas de refus (statut "Annulé"), pour
  // rester consultable dans le Fil de prescription et transmise au service source.
  motifRefus          String?
  priorite            String               @default("Standard")
  statut              String               @default("A planifier")
  dateDemande         DateTime             @default(now())
  checklistApres      ChecklistApres?
  checklistAvant      ChecklistAvant?
  dossierCPA          DossierCPA?
  operationEndoscopie OperationEndoscopie?
  resultatEndoscopie  ResultatEndoscopie?
  rendezVous          RendezVous?
  notes               NoteDossier[]

  @@index([serviceId])
  @@index([patientId])
}

// Trace durable des demandes externes déjà notifiées (DEMANDE_EXAMEN) — évite de
// renotifier la même demande à chaque redémarrage du serveur (Render endort le service
// après inactivité et le redémarre à froid ; sans cette table, une fenêtre de rattrapage
// en mémoire seule pouvait re-détecter comme "nouvelle" une demande déjà notifiée juste
// avant un redémarrage). Purement une trace d'idempotence, jamais lue ailleurs.
model NotifiedPrescription {
  externalId String   @id
  notifiedAt DateTime @default(now())
}

model NoteDossier {
  id             String       @id @default(uuid())
  prescriptionId String
  serviceId      String
  auteur         String
  contenu        String
  dateCreation   DateTime     @default(now())
  prescription   Prescription @relation(fields: [prescriptionId], references: [id])

  @@index([prescriptionId])
  @@index([serviceId])
}

model EndoscopyExamType {
  id          String  @id @default(uuid())
  name        String  @unique
  code        String? @unique
  description String?
}

model RendezVous {
  id             String        @id @default(uuid())
  patientId      String?
  prescriptionId String?       @unique
  salleId        String?
  medecinId      String?
  dateHeureDebut DateTime
  dateHeureFin   DateTime?
  typeAnesthesie String?
  statut         String        @default("Prevu")
  notesCliniques String?
  // Examen additionnel réalisé dans la même séance (cas des patients ayant une double opération).
  typeExamenSecondaire String?
  serviceId      String
  prescription   Prescription? @relation(fields: [prescriptionId], references: [id])
  salle          Salle?        @relation(fields: [salleId], references: [id])

  @@index([patientId])
  @@index([medecinId])
  @@index([prescriptionId])
  @@index([serviceId])
}

model DossierCPA {
  id             String        @id @default(uuid())
  patientId      String
  prescriptionId String?       @unique
  anesthesisteId String?
  typeAnesthesie String?
  observations   String?
  statut         String        @default("Brouillon")
  dateValidation DateTime?
  serviceId      String
  blocDemandeId  String?
  decisionCpa    String?
  dateCpa        DateTime?
  dateVpa        DateTime?
  prescription   Prescription? @relation(fields: [prescriptionId], references: [id])

  @@index([patientId])
  @@index([anesthesisteId])
  @@index([prescriptionId])
  @@index([serviceId])
}

model ChecklistAvant {
  id                    String       @id @default(uuid())
  prescriptionId        String       @unique
  serviceId             String
  dateCreation          DateTime     @default(now())
  dateModification      DateTime     @updatedAt
  // "OUI" / "NON" / "NA" — stockés en texte (pas Boolean) car ces deux items proposent
  // un bouton "NA" dans le formulaire ; un simple booléen ne pouvait pas le distinguer
  // de "NON", ce qui faisait perdre le choix "NA" au rechargement et empêchait la
  // checklist d'être jamais marquée "valide" quand un item ne s'applique pas au patient.
  antibioprophylaxie    String?
  anticoagulantsArretes String?
  constantes_pouls      String?
  constantes_saturation String?
  constantes_tension    String?
  estValide             Boolean      @default(false)
  identiteVerifiee      Boolean      @default(false)
  jeuneRespecte         Boolean      @default(false)
  materielDisponible    Boolean      @default(false)
  observations          String?
  patientId             String
  preparationAdequate   Boolean      @default(false)
  procedureConfirmee    Boolean      @default(false)
  rendezVousId          String?
  risquesVerifies       Boolean      @default(false)
  tenueAppropriee       Boolean      @default(false)
  validationCollegiale  Boolean      @default(false)
  prescription          Prescription @relation(fields: [prescriptionId], references: [id])

  @@index([patientId])
  @@index([prescriptionId])
  @@index([serviceId])
}

model OperationEndoscopie {
  id                    String       @id @default(uuid())
  prescriptionId        String       @unique
  serviceId             String
  dateCreation          DateTime     @default(now())
  dateModification      DateTime     @updatedAt
  observationNotes      String?
  medicalNotes          String?
  patientId             String
  voiceTranscripts      String?
  // Prescription post-acte rédigée par le médecin avant de passer à la check-list après,
  // pour la phase de réveil. Sa présence sert aussi à présélectionner OUI/NON dans cette check-list.
  prescriptionPostActe  String?
  prescription          Prescription @relation(fields: [prescriptionId], references: [id])

  @@index([patientId])
  @@index([prescriptionId])
  @@index([serviceId])
}

model ChecklistApres {
  id                     String       @id @default(uuid())
  prescriptionId         String       @unique
  serviceId              String
  dateCreation           DateTime     @default(now())
  confirmationEtiquetage String?
  dateModification       DateTime     @updatedAt
  estValide              Boolean      @default(false)
  patientId              String
  prescriptionsPostActe  String?
  remarques              String?
  prescription           Prescription @relation(fields: [prescriptionId], references: [id])

  @@index([patientId])
  @@index([prescriptionId])
  @@index([serviceId])
}

model ResultatEndoscopie {
  id               String       @id @default(uuid())
  prescriptionId   String       @unique
  serviceId        String
  reportText       String?
  doctorName       String?
  dateCreation     DateTime     @default(now())
  biopsy           String?
  complication     String?
  conclusion       String?
  dateModification DateTime     @updatedAt
  followUp         String?
  mainDiagnosis    String?
  observations     String?
  patientId        String
  details          String?
  publicToken      String?      @unique
  isPublicShared   Boolean      @default(false)
  sharedAt         DateTime?
  prescription     Prescription @relation(fields: [prescriptionId], references: [id])

  @@index([patientId])
  @@index([prescriptionId])
  @@index([serviceId])
  @@index([publicToken])
}

model ServiceExterne {
  id        String   @id @default(uuid())
  nom       String   @unique
  apiKey    String   @unique
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())
  lastUsedAt DateTime?
  contact   String?
  hopital   String?
  logsAcces LogAccesExterne[]

  @@index([apiKey])
}

model LogAccesExterne {
  id             String          @id @default(uuid())
  serviceExterneId String
  prescriptionId String
  patientId      String
  statut         Int
  timestamp      DateTime        @default(now())
  serviceExterne ServiceExterne  @relation(fields: [serviceExterneId], references: [id], onDelete: Cascade)

  @@index([serviceExterneId])
  @@index([prescriptionId])
  @@index([patientId])
  @@index([timestamp])
}

model ServiceSource {
  id              String   @id @default(uuid())
  nom             String   @unique
  urlWebhook      String
  actif           Boolean  @default(true)
  contact         String?
  hopital         String?
  createdAt       DateTime @default(now())
  lastNotifiedAt  DateTime?
  logsWebhook     LogWebhook[]

  @@index([actif])
}

model LogWebhook {
  id              String       @id @default(uuid())
  serviceSourceId String
  prescriptionId  String
  patientId       String
  eventType       String       @default("EXAMEN_TERMINE")
  httpStatus      Int?
  tentatives      Int          @default(1)
  prochainEssai   DateTime?
  timestamp       DateTime     @default(now())
  serviceSource   ServiceSource @relation(fields: [serviceSourceId], references: [id], onDelete: Cascade)

  @@index([serviceSourceId])
  @@index([prescriptionId])
  @@index([patientId])
  @@index([timestamp])
}
