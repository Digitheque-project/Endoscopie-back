generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Patient {
  id                   String                @id @default(uuid())
  nom                  String
  prenom               String
  dateNaissance        DateTime?
  sexe                 String?
  groupeSanguin        String?
  poids                Float?
  antecedentsMedicaux  String?
  checklistsApres      ChecklistApres[]
  checklistsAvant      ChecklistAvant[]
  dossiersCPA          DossierCPA[]
  operationEndoscopies OperationEndoscopie[]
  prescriptions        Prescription[]
  rendezVous           RendezVous[]
  resultatsEndoscopie  ResultatEndoscopie[]
}

model Medecin {
  id            String         @id @default(uuid())
  nom           String
  prenom        String
  specialite    String?
  role          String?
  dossiersCPA   DossierCPA[]
  prescriptions Prescription[]
  rendezVous    RendezVous[]
}

model Salle {
  id         String       @id @default(uuid())
  nom        String
  numero     String
  capacite   Int          @default(1)
  equipement String?      @default("")
  estActive  Boolean      @default(true)
  serviceId  String
  rendezVous RendezVous[]

  @@index([serviceId])
}

model Prescription {
  id                  String               @id @default(uuid())
  patientId           String
  medecinId           String
  typeExamen          String
  motif               String?
  priorite            String               @default("Standard")
  statut              String               @default("A planifier")
  dateDemande         DateTime             @default(now())
  serviceId           String
  typeExamenRefId     String?
  checklistApres      ChecklistApres?
  checklistAvant      ChecklistAvant?
  dossierCPA          DossierCPA?
  operationEndoscopie OperationEndoscopie?
  medecinPrescripteur Medecin              @relation(fields: [medecinId], references: [id])
  patient             Patient              @relation(fields: [patientId], references: [id])
  typeExamenRef       EndoscopyExamType?   @relation(fields: [typeExamenRefId], references: [id])
  rendezVous          RendezVous?
  resultatEndoscopie  ResultatEndoscopie?

  @@index([medecinId])
  @@index([patientId])
  @@index([serviceId])
  @@index([typeExamenRefId])
}

model EndoscopyExamType {
  id            String         @id @default(uuid())
  name          String         @unique
  code          String?        @unique
  description   String?
  prescriptions Prescription[]
}

model RendezVous {
  id             String        @id @default(uuid())
  patientId      String?
  prescriptionId String?       @unique
  salleId        String?
  medecinId      String?
  dateHeureDebut DateTime
  dateHeureFin   DateTime?
  typeAnesthesie String?
  statut         String        @default("Prevu")
  notesCliniques String?
  serviceId      String
  medecin        Medecin?      @relation(fields: [medecinId], references: [id])
  patient        Patient?      @relation(fields: [patientId], references: [id])
  prescription   Prescription? @relation(fields: [prescriptionId], references: [id])
  salle          Salle?        @relation(fields: [salleId], references: [id])

  @@index([patientId])
  @@index([medecinId])
  @@index([prescriptionId])
  @@index([serviceId])
}

model DossierCPA {
  id             String        @id @default(uuid())
  patientId      String
  prescriptionId String?       @unique
  anesthesisteId String?
  typeAnesthesie String?
  observations   String?
  statut         String        @default("Brouillon")
  dateValidation DateTime?
  serviceId      String
  anesthesiste   Medecin?      @relation(fields: [anesthesisteId], references: [id])
  patient        Patient       @relation(fields: [patientId], references: [id])
  prescription   Prescription? @relation(fields: [prescriptionId], references: [id])

  @@index([patientId])
  @@index([anesthesisteId])
  @@index([prescriptionId])
  @@index([serviceId])
}

model ChecklistAvant {
  id                    String       @id @default(uuid())
  prescriptionId        String       @unique
  serviceId             String
  dateCreation          DateTime     @default(now())
  dateModification      DateTime     @updatedAt
  antibioprophylaxie    Boolean      @default(false)
  anticoagulantsArretes Boolean      @default(false)
  constantes_pouls      String?
  constantes_saturation String?
  constantes_tension    String?
  estValide             Boolean      @default(false)
  identiteVerifiee      Boolean      @default(false)
  jeuneRespecte         Boolean      @default(false)
  materielDisponible    Boolean      @default(false)
  observations          String?
  patientId             String
  preparationAdequate   Boolean      @default(false)
  procedureConfirmee    Boolean      @default(false)
  rendezVousId          String?
  risquesVerifies       Boolean      @default(false)
  tenueAppropriee       Boolean      @default(false)
  validationCollegiale  Boolean      @default(false)
  patient               Patient      @relation(fields: [patientId], references: [id])
  prescription          Prescription @relation(fields: [prescriptionId], references: [id])

  @@index([patientId])
  @@index([prescriptionId])
  @@index([serviceId])
}

model OperationEndoscopie {
  id               String       @id @default(uuid())
  prescriptionId   String       @unique
  serviceId        String
  dateCreation     DateTime     @default(now())
  dateModification DateTime     @updatedAt
  medicalNotes     String?
  patientId        String
  voiceTranscripts Json?
  patient          Patient      @relation(fields: [patientId], references: [id])
  prescription     Prescription @relation(fields: [prescriptionId], references: [id])

  @@index([patientId])
  @@index([prescriptionId])
  @@index([serviceId])
}

model ChecklistApres {
  id                     String       @id @default(uuid())
  prescriptionId         String       @unique
  serviceId              String
  dateCreation           DateTime     @default(now())
  confirmationEtiquetage String?
  dateModification       DateTime     @updatedAt
  estValide              Boolean      @default(false)
  patientId              String
  prescriptionsPostActe  String?
  remarques              String?
  patient                Patient      @relation(fields: [patientId], references: [id])
  prescription           Prescription @relation(fields: [prescriptionId], references: [id])

  @@index([patientId])
  @@index([prescriptionId])
  @@index([serviceId])
}

model ResultatEndoscopie {
  id               String       @id @default(uuid())
  prescriptionId   String       @unique
  serviceId        String
  reportText       String?
  doctorName       String?
  dateCreation     DateTime     @default(now())
  biopsy           String?
  complication     String?
  conclusion       String?
  dateModification DateTime     @updatedAt
  followUp         String?
  mainDiagnosis    String?
  observations     String?
  patientId        String
  patient          Patient      @relation(fields: [patientId], references: [id])
  prescription     Prescription @relation(fields: [prescriptionId], references: [id])

  @@index([patientId])
  @@index([prescriptionId])
  @@index([serviceId])
}
