# Base PostgreSQL (Supabase, schéma endoscopie, pooler en mode session 5432).
DATABASE_URL=
# Passerelle unique du CHU.
GATEWAY_API_URL=
# Secret de vérification des jetons (identique à toute la plateforme).
JWT_SECRET=
# Compte de service rattaché au service « Endoscopie » de son CHU : il donne aussi
# l'identité du service (aucun identifiant de service ou de CHU en variable).
CHU_SERVICE_ACCOUNT_EMAIL=
CHU_SERVICE_ACCOUNT_PASSWORD=
# Facultatifs : PORT, PUBLIC_API_URL (hors Render), FRONTEND_URL (appel direct d'une autre origine),
# NOTIFICATION_WEBHOOK_SECRET.
