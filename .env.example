# Base PostgreSQL (Supabase, schéma endoscopie, pooler en mode session 5432).
DATABASE_URL=
# Passerelle unique du CHU.
GATEWAY_API_URL=
# Secret commun de la plateforme : vérifie les jetons et signe le jeton de service de ce backend
# (appels sans utilisateur). Aucun compte utilisateur ni identifiant de service en variable.
JWT_SECRET=
# Facultatifs : PORT, PUBLIC_API_URL (hors Render), FRONTEND_URL (appel direct d'une autre origine),
# NOTIFICATION_WEBHOOK_SECRET.
