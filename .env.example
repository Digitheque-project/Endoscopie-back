# Copier ce fichier en `.env` et remplir les valeurs réelles. C'est aussi le fichier
# chargé tel quel par `docker-compose.yml` (env_file) pour le conteneur backend — un seul
# `.env` sert à la fois à `npm run start:dev` et au déploiement Docker local, pas besoin
# d'en dupliquer un deuxième pour Docker.

# Base de données déployée — OBLIGATOIRE, jamais de SQLite local (même en dev).
# Actuellement Supabase Postgres, amené à changer vers une autre base plus tard.
DATABASE_URL=
DIRECT_URL=
PORT=

# Origines autorisées en CORS (liste séparée par des virgules) — l'URL du frontend déployé
FRONTEND_URL=

# Fournie automatiquement par Render en production, à laisser vide en local
RENDER_EXTERNAL_URL=

# Identité Endoscopie — serviceId réellement enregistré dans le registre central du CHU.
# Valeur de secours uniquement : résolue automatiquement au démarrage depuis
# SERVICE_REGISTRY_API_URL (voir plus bas).
ENDOSCOPIE_SERVICE_ID=
ENDOSCOPIE_CHU_ID=
CHU_API_URL=

# Alias historique (même valeur qu'ENDOSCOPIE_SERVICE_ID ci-dessus)
ENDOSCOPIE_AUTH_SERVICE_ID=
ENDOSCOPIE_AUTH_CHU_ID=

# Registre central des services CHU — résolution dynamique de l'identité Endoscopie
SERVICE_REGISTRY_API_URL=

# API Accueil (patients du CHU)
ACCUEIL_API_URL=

# Service notifications
NOTIFICATION_API_URL=
# Alias legacy du même service, utilisé par service-source.service.ts uniquement
NOTIFICATION_SERVICE_URL=

# Secret optionnel pour POST /api/notifications/receive (header x-webhook-secret)
NOTIFICATION_WEBHOOK_SECRET=

# API du service Bloc Opératoire (intégration CPA/VPA)
BLOC_API_URL=

# API Prescriptions mutualisée CHU (Railway)
# Ce service exige le même JWT que celui utilisé par nos utilisateurs pour se connecter à
# l'app (voir CHU_AUTH_LOGIN_URL / CHU_SERVICE_ACCOUNT_* ci-dessous).
PRESCRIPTION_EXT_API_URL=

# Écosystème d'authentification CHU partagé — notre backend s'y connecte lui-même (compte
# de service) pour obtenir un token à joindre à ses appels serveur-à-serveur vers des
# services externes qui l'exigent (ex. PRESCRIPTION_EXT_API_URL ci-dessus).
CHU_AUTH_LOGIN_URL=
CHU_SERVICE_ACCOUNT_EMAIL=
CHU_SERVICE_ACCOUNT_PASSWORD=

# Service utilisateurs de l'écosystème d'authentification CHU — liste des médecins et
# résolution du médecin prescripteur (voir src/services/medecins.service.ts). Distinct de
# CHU_AUTH_LOGIN_URL : le login passe par l'auth-service, la lecture des utilisateurs
# interroge ce service directement.
AUTH_USER_SERVICE_URL=

# API Dossier Patient CHU (parcours du patient — suivis, diagnostics, sorties médicales...)
# Authentifié avec le même JWT partagé que le reste de l'écosystème CHU (voir
# CHU_SERVICE_ACCOUNT_EMAIL/PASSWORD plus haut) — pas de token dédié à part.
DOSSIER_PATIENT_API_URL=

# URL publique de l'API (webhook Swagger) si pas sur Render
PUBLIC_API_URL=

# URL publique de ce service (service-source.service.ts) — a un défaut codé en dur si absent
API_URL=
