# Base de données déployée — OBLIGATOIRE, jamais de SQLite local (même en dev).
# Actuellement Supabase Postgres, amené à changer vers une autre base plus tard.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
# Exemple Supabase (pooler transaction-mode, IPv4-only) :
# DATABASE_URL="postgresql://postgres.tnaypvydhpizlvvdqbjv:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
# DIRECT_URL="postgresql://postgres.tnaypvydhpizlvvdqbjv:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"
PORT=3333

# Service Endoscopie (API CHU Railway)
ENDOSCOPIE_SERVICE_ID=38f39d38-152e-495b-8c48-28937750d9eb
ENDOSCOPIE_CHU_ID=72d49761-2a65-446d-b025-15a74cac1ad4
CHU_API_URL=https://service-chu-back-production-d6a8.up.railway.app

# ID service/CHU Endoscopie tels qu'enregistrés dans le service d'authentification
# central (voir AUTH_ENDOSCOPIE_SERVICE_ID côté front) — optionnel, mais recommandé :
# certaines prescriptions externes multi-services sont taguées avec ces ID plutôt
# qu'avec ENDOSCOPIE_SERVICE_ID/ENDOSCOPIE_CHU_ID ci-dessus, selon la source de saisie.
# ENDOSCOPIE_AUTH_SERVICE_ID=ab97eaaa-9239-4f37-b5d7-d652c4231cc7
# ENDOSCOPIE_AUTH_CHU_ID=1e5bbbb7-fa10-4d59-8848-2d0ce96a9394

# API Accueil (patients du CHU) — https://acceuil-back.onrender.com/accueil/api
ACCUEIL_API_URL=https://acceuil-back.onrender.com

# Service notifications — https://notification-back-xrl2.onrender.com/api/docs
NOTIFICATION_API_URL=https://notification-back-xrl2.onrender.com

# Secret optionnel pour POST /api/notifications/receive (header x-webhook-secret)
# NOTIFICATION_WEBHOOK_SECRET=change-me-in-production

# API du service Bloc Opératoire (intégration CPA/VPA) — https://bloc-prud.onrender.com/bloc/api/docs
BLOC_API_URL=https://bloc-prud.onrender.com/bloc/api

# API Prescriptions mutualisée CHU (Railway) — https://prescriptionback-production.up.railway.app/prescriptions/api/docs
# Ce service exige le même JWT que celui utilisé par nos utilisateurs pour se connecter à
# l'app (voir CHU_AUTH_LOGIN_URL / CHU_SERVICE_ACCOUNT_* ci-dessous).
PRESCRIPTION_EXT_API_URL=https://prescriptionback-production.up.railway.app/prescriptions

# Écosystème d'authentification CHU partagé — notre backend s'y connecte lui-même (compte
# de service) pour obtenir un token à joindre à ses appels serveur-à-serveur vers des
# services externes qui l'exigent (ex. PRESCRIPTION_EXT_API_URL ci-dessus).
# Docs des services proxifiés par ce gateway (référence, pas appelés directement par nous) :
#   - Auth    : https://auth-service-ak8j.onrender.com/auth-docs
#   - User    : https://user-services-1sm6.onrender.com/users-docs
#   - Service : https://service-service-votd.onrender.com/services-docs
CHU_AUTH_LOGIN_URL=https://gateway-a33f.onrender.com
CHU_SERVICE_ACCOUNT_EMAIL=
CHU_SERVICE_ACCOUNT_PASSWORD=

# API Dossier Patient CHU (parcours du patient — suivis, diagnostics, sorties médicales...)
# Nécessite un token propre à ce service, pas encore fourni — laisser tel quel, l'app
# gère l'indisponibilité proprement.
DOSSIER_PATIENT_API_URL=https://dossier-patient-back-ri3e.onrender.com/dossier-patient

# URL publique de l'API (webhook Swagger) si pas sur Render
# PUBLIC_API_URL=https://endoscopie-api.onrender.com
